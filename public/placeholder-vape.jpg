<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <rect width="400" height="400" fill="#121124" rx="24"/>
  <defs>
    <linearGradient id="vapeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#45cab4"/>
      <stop offset="100%" stop-color="#188b7d"/>
    </linearGradient>
  </defs>
  <!-- Vape device silhouette -->
  <rect x="150" y="90" width="100" height="220" rx="20" fill="url(#vapeGrad)" />
  <rect x="175" y="60" width="50" height="35" rx="8" fill="#201f38" />
  <rect x="165" y="120" width="70" height="110" rx="10" fill="#0d0c1b" opacity="0.6" />
  <circle cx="200" cy="265" r="12" fill="#0d0c1b" />
  <text x="200" y="350" fill="#8e8d9f" font-family="sans-serif" font-size="14" font-weight="bold" text-anchor="middle">SAVAGE VAPES</text>
</svg>

