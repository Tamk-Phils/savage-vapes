# Supabase Configuration
# Obtain these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Website Information
NEXT_PUBLIC_SITE_NAME="Vape Well Australia"
NEXT_PUBLIC_SITE_URL=https://vapewellaustralia.com.au

# SpaceMail SMTP Email Alerts
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@yourdomain.com
SMTP_PASS=your-spacemail-password
SMTP_FROM="Vape Well Australia <orders@yourdomain.com>"
ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com

